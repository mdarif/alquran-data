# Downloaded QUL source files (large; not redistributed in the repo)
sources/*.sqlite
sources/*.db
sources/*.json

# Build outputs
assets/*.db
build/
# Per-edition download artifacts (build_editions.py) — uploaded to R2, never
# committed: ~1.5 MB per build and regenerated deterministically from quran.db.
dist/

# Stray DBs at the repo root — a pipeline step run from the wrong cwd drops
# empty SQLite files here. They never belong in the repo.
/*.db
/*.sqlite

# Local config (may contain machine-specific paths)
config/sources.yaml

# Generated test fixtures
tests/fixtures/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Claude Code local settings
.claude/

# macOS
.DS_Store
**/.DS_Store

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
sources/ahsanul-kalam/

# Wrangler local state — caches your Cloudflare account id and a simulated
# bucket. Untracked so far by luck, not by rule; this repo is public.
.wrangler/
